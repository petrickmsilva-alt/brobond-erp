# Copie para .env e ajuste. No Render essas variáveis são configuradas no painel / render.yaml.

# Banco de dados (PostgreSQL). Sem esta variável a API roda em MODO DEMONSTRAÇÃO
# (dados em memória, apagados ao reiniciar). Com ela, o schema (db/schema.sql)
# é aplicado automaticamente na inicialização.
#
# GRATUITO E PERMANENTE: crie um projeto em https://neon.tech (0,5 GB, sem prazo
# de expiração) e cole aqui a "connection string" (termina com ?sslmode=require).
# O Postgres gratuito da Render EXPIRA em 30 dias — não use em produção.
DATABASE_URL=postgres://usuario:senha@localhost:5432/brobond

# ============================================================
# LOJA VIRTUAL (WordPress + WooCommerce) — brobond.com.br
# ============================================================
# Liga o ERP ao site: importa os pedidos da loja como Vendas e empurra o saldo
# do ERP para a loja. Guia completo: docs/INTEGRACAO-LOJA.md
# As chaves são criadas em WooCommerce › Configurações › Avançado › API REST
# (permissão de Leitura/Gravação). Sem estas variáveis os endpoints respondem
# 409 avisando que a loja não está configurada — nada quebra.
WOOCOMMERCE_URL=https://brobond.com.br
WOOCOMMERCE_CK=
WOOCOMMERCE_CS=
# Status dos pedidos importados (pending, processing, on-hold, completed).
WOOCOMMERCE_STATUS=processing
# Canal lançado nas vendas importadas: site_varejo (padrão) ou site_atacado.
WOOCOMMERCE_CANAL=site_varejo
# Sites autorizados a incorporar o catálogo público do ERP em <iframe>.
# Lista fechada — nunca use "*".
CATALOGO_EMBED_ORIGENS=https://brobond.com.br

# Fotos de produtos.
#   db          (padrão) as imagens ficam no próprio banco, já otimizadas pelo
#               navegador (~150 KB cada). Zero configuração.
#   cloudinary  envia para o Cloudinary (plano gratuito: 25 GB, CDN). Crie a
#               conta em https://cloudinary.com e copie a "API environment variable".
UPLOAD_PROVIDER=db
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=brobond

# Endereço público do ERP — OBRIGATÓRIO quando há SMTP configurado.
# É a base de todo link que sai por e-mail (convite de acesso, "esqueci minha
# senha"), do portal do cliente e das etiquetas com QR code: o link precisa ser
# completo (https://...) — com um link pela metade ("/convite/abc") o destinatário
# vê "URL inválida" no Gmail/Outlook, porque falta o endereço do site.
#   - pode ser com ou sem "https://" e com ou sem a barra final (os dois são aceitos)
#   - sem esta variável, o link usa o endereço salvo pelo administrador em
#     Configurações › Sistema (tabela `configuracoes`, chave `app_url`) — é a
#     forma de resolver o "URL inválida" sem redeploy, direto pela interface
#   - sem os dois, o link usa o endereço por onde você navegava ao gerar o
#     convite (funciona, mas quebra se o ERP mudar de domínio/porta)
#   - em desenvolvimento, sem nada disso, o link aponta para http://localhost:5173
#   - ⚠️ EM PRODUÇÃO este valor PRECISA ser público: "http://localhost:5173",
#     IP privado (10.x, 192.168.x), nome sem domínio ("brobond-erp") ou sufixo
#     reservado (.local, .internal) são DESCARTADOS — o link assim não abre para
#     quem recebe ("URL inválida" no Gmail/Outlook). O servidor então usa a
#     origem da requisição e avisa no boot e em Configurações › Sistema.
APP_URL=http://localhost:5173
# Produção (Render): use o domínio público do serviço, ex. https://erp.brobond.com.br
# Exceção: ERP acessado SOMENTE pela rede interna (sem endereço público) — ligue
# APP_URL_PERMITIR_INTERNA=true para aceitar localhost/IP privado como base.
# APP_URL_PERMITIR_INTERNA=false

# Segurança
# Origens extras permitidas no CORS (só necessário se o front for servido em outro domínio)
# CORS_ORIGINS=https://brobond.com.br,https://erp.brobond.com.br
# Limite de tentativas de login (padrão: 5 tentativas em 15 minutos por IP + e-mail)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=900000

# Segredo do JWT — use um valor longo e aleatório em produção.
JWT_SECRET=troque-por-um-segredo-bem-longo-e-aleatorio
# Validade do token (padrão 8h)
JWT_TTL=8h

# Administrador inicial. Na primeira inicialização o usuário é criado no banco
# com a senha em hash bcrypt. Depois disso a senha pode ser trocada pela interface
# (Configurações › Trocar senha) e o valor aqui deixa de ser usado.
ADMIN_EMAIL=admin@brobond.com.br
ADMIN_PASSWORD=brobond123
# Defina como "true" apenas para RECUPERAR o acesso: força a senha do admin de
# volta para ADMIN_PASSWORD na próxima inicialização. Volte para false depois.
ADMIN_FORCE_PASSWORD=false

PORT=3001

# Pool de conexão com o Postgres (ajuste conforme a carga esperada)
# PG_POOL_MAX=10              # máximo de conexões simultâneas
# PG_CONNECT_TIMEOUT=5000     # timeout para estabelecer conexão (ms)
# PG_IDLE_TIMEOUT=30000       # tempo máximo de conexão ociosa (ms)

# Chave do cofre de senhas: 32 bytes em base64 (ex.: openssl rand -base64 32)
VAULT_KEY=
VAULT_COOLDOWN_MS=30000

# ============================================================
# CONECTORES MULTICANAL — Brobond AI ERP (módulo commerce, Fase 1)
# ============================================================
# Credenciais dos canais de venda do TRIO de produção (Mercado Livre,
# Mercado Pago, Nuvemshop). Sem estas variáveis os conectores ficam
# simplesmente DESCONNECTED — nada quebra. Os SEGREDOS de conta (tokens
# OAuth do lojista) são gravados CIFRADOS (AES-256-GCM) na tabela
# `connectors`; estas variáveis são as credenciais da APLICAÇÃO
# (cadastro no portal de cada plataforma).
#
# Callbacks/webhooks usam o APP_URL acima como base:
#   ${APP_URL}/api/connectors/<canal>/callback

# Cifra em repouso as credenciais dos conectores (AES-256-GCM).
# Exatamente 32 bytes em base64/base64url (ou 64 hex). Gere com:
#   openssl rand -base64 32
# ⚠️ NÃO troque depois de conectar contas: a nova chave não consegue
# decifrar o que a antiga cifrou (o conector fica REAUTH_REQUIRED e
# precisa ser reconectado).
CONNECTOR_ENCRYPTION_KEY=

# --- Mercado Livre (Meli API) ------------------------------------
# DevCenter (developers.mercadolivre.com.br) → sua aplicação.
# Registre o redirect como ${APP_URL}/api/connectors/mercadolivre/callback
# — byte a byte igual ao enviado no OAuth (a Meli valida duas vezes:
# na autorização E na troca do code; URIs divergentes são a causa #1
# de "Não foi possível listar os anúncios"). No deploy da Render o valor
# é https://brobond-erp.onrender.com/api/connectors/mercadolivre/callback
# (o painel envia essa origem dinamicamente ao iniciar a conexão; o
# servidor valida e persiste a URI com o state para repeti-la na troca).
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
# String aleatória sua, exigida na query do webhook registrado:
# ${APP_URL}/api/webhooks/mercadolivre?secret=<MERCADOLIVRE_WEBHOOK_SECRET>
# MERCADOLIVRE_WEBHOOK_SECRET=
# Overrides operacionais (padrões já apontam para a Meli Brasil):
# MERCADOLIVRE_AUTH_BASE_URL=https://auth.mercadolivre.com.br
# MERCADOLIVRE_API_BASE_URL=https://api.mercadolibre.com

# --- Nuvemshop (Tiendanube) --------------------------------------
# PLATAFORMA-PONTE do Hub Omnichannel: a triangulação de vendas (e o
# catálogo exibido no TikTok) passa por aqui desde que os conectores
# nativos de Shopee e TikTok foram removidos do ecossistema.
#
# Crie o app no Portal de Parceiros (partners.nuvemshop.com.br) e copie
# o App ID (client_id) e o Client Secret. A "URL de redirecionamento"
# cadastrada lá precisa ser EXATAMENTE o valor de NUVEMSHOP_REDIRECT_URI
# — na Render, https://brobond-erp.onrender.com/api/connectors/nuvemshop/callback.
#
# ⚠️ O access token da Nuvemshop é PERMANENTE (só é invalidado quando um
# novo é emitido ou quando o lojista desinstala o app): não há refresh
# token e nada expira sozinho.
#
# O webhook (${APP_URL}/api/webhooks/nuvemshop) é assinado com HMAC-SHA256
# do corpo cru usando o PRÓPRIO NUVEMSHOP_CLIENT_SECRET, no cabeçalho
# x-linkedstore-hmac-sha256 — não existe segredo de webhook separado.
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
NUVEMSHOP_REDIRECT_URI=http://localhost:5173/api/connectors/nuvemshop/callback
# Overrides operacionais (os padrões apontam para os endpoints do Brasil;
# para lojas LATAM use os espelhos tiendanube.com):
# NUVEMSHOP_API_BASE_URL=https://api.nuvemshop.com.br/v1
# NUVEMSHOP_AUTH_BASE_URL=https://www.nuvemshop.com.br
# Identificação exigida pela plataforma em toda requisição:
# NUVEMSHOP_USER_AGENT=Brobond AI ERP (contato@brobond.com.br)

# --- Mercado Pago -----------------------------------------------
# Preferencial: cadastre as credenciais de PRODUÇÃO do vendedor pelo
# painel (Conectores → Mercado Pago), onde são cifradas em
# `connectors`. Este par é o fallback server-side:
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Webhook: ${APP_URL}/api/webhooks/mercadopago — assinatura HMAC
# verificada no cabeçalho x-signature quando definida:
# MERCADOPAGO_WEBHOOK_SECRET=
# MERCADOPAGO_API_BASE_URL=https://api.mercadopago.com
