# Copie para .env e ajuste. No Render essas variáveis são configuradas no painel / render.yaml.

# Banco de dados (PostgreSQL). Sem esta variável a API roda em MODO DEMONSTRAÇÃO
# (dados em memória, apagados ao reiniciar). Com ela, o schema (db/schema.sql)
# é aplicado automaticamente na inicialização.
#
# GRATUITO E PERMANENTE: crie um projeto em https://neon.tech (0,5 GB, sem prazo
# de expiração) e cole aqui a "connection string" (termina com ?sslmode=require).
# O Postgres gratuito da Render EXPIRA em 30 dias — não use em produção.
DATABASE_URL=postgres://usuario:senha@localhost:5432/brobond

# Fotos de produtos.
#   db          (padrão) as imagens ficam no próprio banco, já otimizadas pelo
#               navegador (~150 KB cada). Zero configuração.
#   cloudinary  envia para o Cloudinary (plano gratuito: 25 GB, CDN). Crie a
#               conta em https://cloudinary.com e copie a "API environment variable".
UPLOAD_PROVIDER=db
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=brobond

# Endereço público do ERP — OBRIGATÓRIO quando há SMTP configurado.
# É a base de todo link que sai por e-mail (convite de acesso, "esqueci minha
# senha"), do portal do cliente e das etiquetas com QR code: o link precisa ser
# completo (https://...) — com um link pela metade ("/convite/abc") o destinatário
# vê "URL inválida" no Gmail/Outlook, porque falta o endereço do site.
#   - pode ser com ou sem "https://" e com ou sem a barra final (os dois são aceitos)
#   - sem esta variável, o link usa o endereço salvo pelo administrador em
#     Configurações › Sistema (tabela `configuracoes`, chave `app_url`) — é a
#     forma de resolver o "URL inválida" sem redeploy, direto pela interface
#   - sem os dois, o link usa o endereço por onde você navegava ao gerar o
#     convite (funciona, mas quebra se o ERP mudar de domínio/porta)
#   - em desenvolvimento, sem nada disso, o link aponta para http://localhost:5173
#   - ⚠️ EM PRODUÇÃO este valor PRECISA ser público: "http://localhost:5173",
#     IP privado (10.x, 192.168.x), nome sem domínio ("brobond-erp") ou sufixo
#     reservado (.local, .internal) são DESCARTADOS — o link assim não abre para
#     quem recebe ("URL inválida" no Gmail/Outlook). O servidor então usa a
#     origem da requisição e avisa no boot e em Configurações › Sistema.
APP_URL=http://localhost:5173
# Produção (Render): use o domínio público do serviço, ex. https://erp.brobond.com.br
# Exceção: ERP acessado SOMENTE pela rede interna (sem endereço público) — ligue
# APP_URL_PERMITIR_INTERNA=true para aceitar localhost/IP privado como base.
# APP_URL_PERMITIR_INTERNA=false

# Segurança
# Origens extras permitidas no CORS (só necessário se o front for servido em outro domínio)
# CORS_ORIGINS=https://brobond.com.br,https://erp.brobond.com.br
# Limite de tentativas de login (padrão: 5 tentativas em 15 minutos por IP + e-mail)
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MS=900000

# Segredo do JWT — use um valor longo e aleatório em produção.
JWT_SECRET=troque-por-um-segredo-bem-longo-e-aleatorio
# Validade do token (padrão 8h)
JWT_TTL=8h

# Administrador inicial. Na primeira inicialização o usuário é criado no banco
# com a senha em hash bcrypt. Depois disso a senha pode ser trocada pela interface
# (Configurações › Trocar senha) e o valor aqui deixa de ser usado.
ADMIN_EMAIL=admin@brobond.com.br
ADMIN_PASSWORD=brobond123
# Defina como "true" apenas para RECUPERAR o acesso: força a senha do admin de
# volta para ADMIN_PASSWORD na próxima inicialização. Volte para false depois.
ADMIN_FORCE_PASSWORD=false

PORT=3001

# Pool de conexão com o Postgres (ajuste conforme a carga esperada)
# PG_POOL_MAX=10              # máximo de conexões simultâneas
# PG_CONNECT_TIMEOUT=5000     # timeout para estabelecer conexão (ms)
# PG_IDLE_TIMEOUT=30000       # tempo máximo de conexão ociosa (ms)

# Chave do cofre de senhas: 32 bytes em base64 (ex.: openssl rand -base64 32)
VAULT_KEY=
VAULT_COOLDOWN_MS=30000
