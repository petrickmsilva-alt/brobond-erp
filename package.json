{
  "name": "brobond-ai-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "server", "client"],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "install:all": "npm install",
    "build": "npm --workspace client run build",
    "typecheck": "npm run typecheck:domain && npm --workspace server run typecheck && npm --workspace client run typecheck",
    "typecheck:domain": "npm --workspace @brobond/domain run typecheck",
    "test": "npm --workspace server test && npm --workspace client test",
    "lint": "eslint 'server/src/**/*.ts' 'modules/**/*.ts' 'packages/*/src/**/*.ts' 'client/src/**/*.{ts,tsx}'",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "prisma": { "schema": "prisma/schema.prisma" },
  "devDependencies": { "@typescript-eslint/eslint-plugin": "^8.69.0", "@typescript-eslint/parser": "^8.69.0", "concurrently": "^9.1.0", "eslint": "^9.39.5", "eslint-plugin-react": "^7.37.5", "eslint-plugin-react-hooks": "^7.1.1", "prettier": "^3.2.0", "prisma": "6.12.0" }
}
