+++ b/.github/workflows/backup.yml
@@ -0,0 +1,49 @@
+name: Backup diário do Postgres
+
+on:
+  schedule:
+    - cron: '0 4 * * *'   # 04:00 UTC todo dia
+ +      - uses: actions/checkout workflow_dispatch: {}
+
+concurrency:
+  group: backup-postgres
+  cancel-in-progress: false
+
+jobs:
+  backup:
+    runs-on: ubuntu-l@v4
+
+      - name: Instalar dependências
+        run: sudo apt-get update && sudo apt-get install -y postgresql-client zstd
+
+      - name: Gerar backup
+        env:
+          DATABASE_URL: ${{ secrets.PROD_DATABASE_URL }}
+          BACKUP_DIR: ${{ runner.temp }}/backups
+          RETENTION_DAYS: '30'
+          VALIDATE_RESTORE: 'true'
+        run: bash scripts/backup-postgres.sh
+
+      - name: Persistir artefato (90 dias)
+        uses: actions/upload-artifact@v4
+        with:
+          name: brobond-backup-${{ github.run_id }}
+          path: ${{ runner.temp }}/backups/*.dump.zst
+          retention-days: 90
+          if-no-files-found: error
+
+      - name: Alerta em caso de falha
+        if: failure()
+        uses: actions/github-script@v7
+        with:
+          script: |
+            await github.rest.issues.create({
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              title: 'FALHA NO BACKUP AUTOMÁTICO',
+              labels: ['crítico', 'backup'],
+              body: 'Backup diário falhou em ' + new Date().toISOString() + '. Verifique imediatamente.'
+            });
