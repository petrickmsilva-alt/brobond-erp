@@ -0,0 +1,40 @@
+import type { PrismaClient } from '@prisma/client';
+
+/**
+ * Advisory lock para impedir migrações concorrentes.
+ *
+ * Uso:
+ *   await withAdvisoryLock(prisma, async () => {
+ *     await aplicarMigracoes(prisma);
+ *   });
+ */
+
+const LOCK_KEY = 727272;
+
+export async function withAdvisoryLock<T>(
+  prisma: PrismaClient,
+  fn: () => Promise<T>,
+  timeoutMs = 60_000
+): Promise<T> {
+  const deadline = Date.now() + timeoutMs;
+
+  for (;;) {
+    const rows = await prisma.$queryRaw<{ locked: boolean }[]>`
+      SELECT pg_try_advisory_lock(${LOCK_KEY}) AS locked
+    `;
+    if (rows[0]?.locked) break;
+
+    if (Date.now() > deadline) {
+      throw new Error(
+        `Não foi possível adquirir advisory lock (${LOCK_KEY}) em ${timeoutMs}ms`
+      );
+    }
+    await new Promise((resolve) => setTimeout(resolve, 500));
+  }
+
+  try {
+    return await fn();
+  } finally {
+    await prisma.$queryRaw`SELECT pg_advisory_unlock(${LOCK_KEY})`;
+  }
+}
