+#!/usr/bin/env bash
+set -euo pipefail
+
+# ============================================================================
+# Backup automatizado do Postgres — Brobond ERP
+#
+# Uso:
+#   DATABASE_URL=postgres://... BACKUP_DIR=/backups ./scripts/backup-postgres.sh
+#
+# O que faz:
+#   1. pg_dump em formato custom
+#   2. Compressão zstd
+#   3. Validação do dump (restore em banco temporário)
+#   4. Retenção configurável (padrão: 30 dias)
+# ============================================================================
+
+: "${DATABASE_URL:?Defina DATABASE_URL}"
+: "${BACKUP_DIR:=/backups}"
+: "${RETENTION_DAYS:=30}"
+: "${VALIDATE_RESTORE:=true}"
+
+STAMP="$(date +%F_%H-%M-%S)"
+FILE="${BACKUP_DIR}/brobond-${STAMP}.dump.zst"
+LOCK="/tmp/brobond-backup.lock"
+
+mkdir -p "${BACKUP_DIR}"
+
+# Evita dois backups simultâneos
+exec 9>"${LOCK}"
+if ! flock -n 9; then
+  echo "Outro backup em andamento — abortando."
+  exit 0
+fi
+
+# Monta a URL por banco preservando a query string (?sslmode=require etc.)
+QUERY_STRING=""
+case "${DATABASE_URL}" in
+  *\?*) QUERY_STRING="${DATABASE_URL#*\?}" ;;
+esac
+BASE_PREFIX="${DATABASE_URL%%\?*}"
+BASE_PREFIX="${BASE_PREFIX%/*}"
+
+url_for() {
+  if [ -n "${QUERY_STRING}" ]; then
+    printf '%s/%s?%s' "${BASE_PREFIX}" "$1" "${QUERY_STRING}"
+  else
+    printf '%s/%s' "${BASE_PREFIX}" "$1"
+  fi
+}
+
+echo "[backup] Iniciando ${STAMP}"
+
+pg_dump --format=custom --no-owner --no-privileges "${DATABASE_URL}" \
+  | zstd -T0 -19 -o "${FILE}"
+
+echo "[backup] Dump gerado: ${FILE} ($(du -h "${FILE}" | cut -f1))"
+
+if [ "${VALIDATE_RESTORE}" = "true" ]; then
+  TMPDB="brobond_restore_check_${STAMP}"
+  ADMIN_URL="$(url_for postgres)"
+
+  cleanup() {
+    psql "${ADMIN_URL}" -qc "DROP DATABASE IF EXISTS \"${TMPDB}\"" >/dev/null 2>&1 || true
+  }
+  trap cleanup EXIT
+
+  psql "${ADMIN_URL}" -qc "CREATE DATABASE \"${TMPDB}\"" >/dev/null
+  zstd -dc "${FILE}" | pg_restore --dbname="$(url_for "${TMPDB}")" --exit-on-error
+  echo "[backup] Restore de validação OK"
+
+  cleanup
+  trap - EXIT
+fi
+
+find "${BACKUP_DIR}" -name 'brobond-*.dump.zst' -mtime "+${RETENTION_DAYS}" -delete
+echo "[backup] Retenção aplicada: ${RETENTION_DAYS} dias"
+echo "[backup] Concluído"
