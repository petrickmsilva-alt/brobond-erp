{
  "name": "brobond-print-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agente local de impressão do BroBond ERP (P1) — polling na fila PrintIR, claim/lease, machine identity. Escuta somente em 127.0.0.1.",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
