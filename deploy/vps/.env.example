# ============================================================================
# Variáveis do ambiente de MEDIÇÃO na VPS.
#
# ATENÇÃO: para o benchmark ser válido, use o MESMO banco Neon da Render
# (idealmente um BRANCH do Neon, para não gerar carga de teste no banco de
# produção) e a MESMA versão da aplicação.
# ============================================================================
# Conexão POOLED do Neon (host com "-pooler"). Runtime usa sempre a pooled;
# migrations também funcionam nela no Neon, mas prefira a direta para operações
# de sessão/advisory lock quando disponível.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.us-east-2.aws.neon.tech/brobond?sslmode=verify-full
PG_POOL_MAX=10

# Segredos (gere novos; NÃO reaproveite os de produção)
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
MFA_ENCRYPTION_KEY=troque-por-32-bytes-base64
ADMIN_EMAIL=admin@brobond.com.br
ADMIN_PASSWORD=troque-esta-senha
APP_URL=http://SEU_IP_OU_DOMINIO:8080

# Opcionais
UPLOAD_PROVIDER=db
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
